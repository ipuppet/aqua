{
  "name": "aqua-frontend",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present && npm run test -w @aqua/http",
    "test": "npm run test -w @aqua/http",
    "dev:admin": "npm run dev -w @aqua/admin",
    "dev:blog": "npm run dev -w @aqua/blog",
    "dev:passport": "npm run dev -w @aqua/passport",
    "build:admin": "npm run build -w @aqua/admin",
    "build:blog": "npm run build -w @aqua/blog",
    "build:passport": "npm run build -w @aqua/passport",
    "deploy:admin": "npm run deploy -w @aqua/admin",
    "deploy:blog": "npm run deploy -w @aqua/blog",
    "deploy:passport": "npm run deploy -w @aqua/passport",
    "versions:admin": "npm run versions -w @aqua/admin",
    "versions:blog": "npm run versions -w @aqua/blog",
    "versions:passport": "npm run versions -w @aqua/passport",
    "gen": "npm run gen -w @aqua/http"
  },
  "overrides": {
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.12"
    },
    "form-data": "4.0.6",
    "linkify-it": "5.0.2",
    "markdown-it": "^14.3.3",
    "js-yaml": "4.3.2",
    "immutable": "5.1.9",
    "postcss": "8.5.25",
    "esbuild": "0.28.1",
    "sharp": "^0.35.5",
    "undici": "^7.30.1",
    "source-map-js": "^1.2.2",
    "tinypool": "^2.1.2",
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@2": "^2.1.7",
    "brace-expansion@5": "^5.0.12"
  }
}
