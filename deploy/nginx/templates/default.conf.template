map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

# Frontend static sites. AQUA_DOMAIN is substituted by the nginx image entrypoint.
server {
    listen 80;
    server_name admin.${AQUA_DOMAIN};

    root /usr/share/nginx/html/admin;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 80;
    server_name blog.${AQUA_DOMAIN};

    root /usr/share/nginx/html/blog;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 80;
    server_name passport.${AQUA_DOMAIN};

    root /usr/share/nginx/html/passport;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# API gateway. The frontend builds URLs as https://api.<domain>/<service>/api/...
# and the gateway strips the service prefix before forwarding to the mono server.
server {
    listen 80;
    server_name api.${AQUA_DOMAIN};
    server_tokens off;
    client_max_body_size 16m;

    # Cookie-based auth is shared across the frontend subdomains.
    add_header Access-Control-Allow-Origin $http_origin always;
    add_header Access-Control-Allow-Credentials "true" always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type, X-Requested-With" always;
    add_header Access-Control-Expose-Headers "Content-Length, Content-Type" always;
    add_header Vary "Origin" always;

    if ($request_method = OPTIONS) {
        return 204;
    }

    location = /ping {
        proxy_pass http://api:8080/ping;
        include /etc/nginx/proxy.inc;
    }

    location ~ ^/(admin|blog|passport|user)/ {
        rewrite ^/(admin|blog|passport|user)/(.*)$ /$2 break;
        proxy_pass http://api:8080;
        include /etc/nginx/proxy.inc;
    }

    # Uploaded images are written by the api container into the shared volume.
    location ^~ /image/ {
        root /srv/aqua;
        try_files $uri =404;
    }

    location / {
        return 404;
    }
}
