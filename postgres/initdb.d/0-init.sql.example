-- Example bootstrap for the Aqua database.
-- Replace change-me with a strong password before use.
CREATE USER "web" WITH LOGIN PASSWORD 'change-me';
CREATE DATABASE "web";
GRANT CONNECT ON DATABASE "web" TO "web";

\c "web"

CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
CREATE SCHEMA IF NOT EXISTS "public";
CREATE SCHEMA IF NOT EXISTS "ums";
CREATE SCHEMA IF NOT EXISTS "blog";

GRANT USAGE, CREATE ON SCHEMA "public" TO "web";
GRANT USAGE, CREATE ON SCHEMA "ums" TO "web";
GRANT USAGE, CREATE ON SCHEMA "blog" TO "web";

GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA "public" TO "web";
GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA "public" TO "web";
GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA "ums" TO "web";
GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA "ums" TO "web";
GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA "blog" TO "web";
GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA "blog" TO "web";
